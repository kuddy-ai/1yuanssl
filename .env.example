# 应用配置
APP_NAME=1yuanssl
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./data/1yuanssl.db
# 生产环境使用 PostgreSQL：
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/1yuanssl

# 加密密钥（⚠️ 生产环境必须修改！）
# 使用强随机密钥，建议 32 字节以上
ENCRYPTION_KEY=change-me-in-production-use-strong-random-key

# 管理员认证（⚠️ 生产环境必须修改！）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_API_TOKEN=dev-admin-token

# ACME 配置
ACME_MODE=mock  # mock/letsencrypt_staging/letsencrypt_prod
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# Staging 环境：
# ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory

# 安全配置
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:7001,http://localhost:3000,http://localhost

# 前端配置
VITE_API_BASE_URL=http://localhost:7000/api/v1
VITE_APP_TITLE=1yuanssl
